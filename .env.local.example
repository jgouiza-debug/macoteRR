# Copy to .env.local and fill in once a Supabase project exists (see docs/SETUP-CLOUD.md).
# Never commit .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: collector/promotion scripts only (scripts/collectors/**).
# Bypasses Row Level Security — never prefix with NEXT_PUBLIC_, never import
# scripts/collectors/lib/staging-client.ts from src/app or src/components.
SUPABASE_SERVICE_ROLE_KEY=
