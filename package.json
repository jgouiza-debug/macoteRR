{
  "name": "macote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "collect:sainte-foy": "tsx scripts/collectors/manual/compile-sainte-foy.ts",
    "promote:review": "tsx scripts/collectors/promote/promote-staging.ts review",
    "promote": "tsx scripts/collectors/promote/promote-staging.ts promote",
    "bench": "tsx scripts/benchmark/run-all.ts",
    "test:rls": "tsx scripts/benchmark/test-rls.ts",
    "build:catalog": "tsx scripts/data/build-catalog.ts",
    "check:data": "tsx scripts/checks/data-integrity.check.ts && tsx scripts/checks/program-eligibility.check.ts && tsx scripts/checks/calibration.check.ts && tsx scripts/checks/notifications.check.ts",
    "check:notifications": "tsx scripts/checks/notifications.check.ts",
    "check:rscore": "tsx scripts/checks/calibration.check.ts",
    "db:local": "bash scripts/db/local/up.sh",
    "shots": "tsx scripts/screenshots/walk.ts",
    "build:schema": "tsx scripts/db/build-full-schema.ts",
    "check:schema": "tsx scripts/db/build-full-schema.ts --check",
    "i18n:unused": "tsx scripts/i18n/unused-keys.ts",
    "gen:types": "tsx scripts/db/gen-types.ts"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "beautifulsoup4": "^0.0.1-security",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "requests": "^0.3.0",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.62.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
